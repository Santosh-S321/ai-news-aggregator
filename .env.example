# Neon direct (non-pooled) connection string, e.g. postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Test database only (name must contain "test"); used by pytest, never by the app
# TEST_DATABASE_URL=

# --- LLM provider: "gemini" or "openai" ---
LLM_PROVIDER=gemini
# API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=

# Gmail: use an app password (Google Account > Security > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_TO=you@gmail.com

# Optional overrides (blank = provider default)
# SUMMARY_MODEL=
# RERANK_MODEL=
# EMBEDDING_MODEL=
# WORKERS=2                # lower if you hit rate limits (429)
# REQUESTS_PER_MINUTE=12   # client-side throttle; 0 = off
# TOP_N=10
# LOOKBACK_HOURS=48
# ENABLE_YOUTUBE_TRANSCRIPTS=false